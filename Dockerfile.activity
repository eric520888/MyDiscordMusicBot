FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY activity_backend/requirements.txt /app/activity_backend/requirements.txt
RUN pip install --no-cache-dir -r /app/activity_backend/requirements.txt

COPY werewolf_engine /app/werewolf_engine
COPY activity_backend /app/activity_backend

CMD ["sh", "-c", "uvicorn activity_backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
