DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token
GEMINI_API_KEY=replace_with_your_gemini_api_key
OWNER_IDS=123456789012345678
LOG_LEVEL=INFO

# YouTube 驗證：cookie 檔案優先；留空時可使用瀏覽器 cookie。
# Windows 本機可用 auto、firefox、chrome、edge 或 brave。
YTDLP_COOKIES_FROM_BROWSER=auto
YTDLP_COOKIE_FILE=

# Railway：把 Netscape cookies.txt 做 Base64 後存成 Secret，勿提交原檔。
YTDLP_COOKIES_B64=

# auto 優先使用驗證元件與 yt-dlp 預設播放器；無 JS runtime 才用低資源模式。
YTDLP_LOW_RESOURCE=auto

# 選填：主機出口 IP 被 YouTube 限制時，使用你自己的 HTTP/HTTPS/SOCKS 代理。
# 解析、驗證與音訊下載會走同一代理，勿把含密碼的網址提交至 Git。
YTDLP_PROXY=

# Railway 預設會把 Deno V8 heap 限為 64 MB；需要時可在這裡覆寫。
YTDLP_DENO_V8_FLAGS=

# Railway 預設讓 Node 的 YouTube challenge solver 使用 192 MB。
YTDLP_NODE_OPTIONS=
